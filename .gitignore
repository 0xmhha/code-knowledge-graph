# Local Claude settings
.claude/settings.local.json

# internal/server/web_assets/ is generated by `make viewer`. Track only a
# stub index.html so go:embed has content on fresh clones (`go build ./cmd/ckg`
# without `make viewer` still produces a working binary that points the user
# at the build command). Next.js's _next/static/<buildID>/ rotates per build
# and would otherwise dirty the tree on every `make build`, so it stays
# generated-only. Same for 404 and index.txt.
/internal/server/web_assets/_next/
/internal/server/web_assets/404/
/internal/server/web_assets/404.html
/internal/server/web_assets/index.txt
