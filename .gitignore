# Local Claude settings
.claude/settings.local.json

# internal/server/web_assets/ is generated by `make viewer` (rm -rf then
# cp from Next.js out/). Track only .gitkeep so go:embed has a non-empty
# directory on fresh clones; everything else regenerates per build.
# Next.js rotates a build-ID directory under _next/static/ which would
# otherwise dirty the tree on every `make build`.
/internal/server/web_assets/_next/
/internal/server/web_assets/404/
/internal/server/web_assets/404.html
/internal/server/web_assets/index.html
/internal/server/web_assets/index.txt
