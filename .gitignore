# Binaries
/bin/
*.exe

# Local graph DBs (large; rebuilt from source via `ckg build`)
.ckg-stablenet*

# Test coverage
coverage.out
*.coverprofile

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Build outputs
/web/viewer-next/node_modules/
/web/viewer-next/.next/
/web/viewer-next/out/
/web/viewer-next/test-results/
/web/viewer-next/playwright-report/

# CKG runtime outputs
/tmp/ckg-*
*.db-journal
*.db-shm
*.db-wal

# Local test build outputs (graph.db + manifest.json from ad-hoc `ckg build` runs)
/go-stable-code/

# Machine-local environment (STABLENET_SRC, EVAL_DB_ROOT etc.)
.env.local

# Local Claude settings
.claude/settings.local.json

# Playwright MCP session artifacts (snapshots + console logs per browser nav)
.playwright-mcp/

# Ad-hoc debug screenshots produced during viewer iteration
/ckg-*.png

# Python bytecode (eval/ scripts)
__pycache__/
*.pyc

# internal/server/web_assets/ is generated by `make viewer`. Track only a
# stub index.html so go:embed has content on fresh clones (`go build ./cmd/ckg`
# without `make viewer` still produces a working binary that points the user
# at the build command). Next.js's _next/static/<buildID>/ rotates per build
# and would otherwise dirty the tree on every `make build`, so it stays
# generated-only. Same for 404 and index.txt.
/internal/server/web_assets/_next/
/internal/server/web_assets/404/
/internal/server/web_assets/404.html
/internal/server/web_assets/index.txt
.ckg-data/
# `make eval` writes here. The .ckg-data dump is rebuild material
# (gitignore'd) and results/ is per-run output (gitignore'd); only
# eval/baseline/*.json is the committed regression snapshot.
eval/.ckg-data/
eval/.synthetic-data/
eval/results/

# Per-session eval result reports. These are point-in-time measurements
# tied to a specific machine + LLM backend + corpus snapshot, not source
# code. They live in docs/ for convenient browsing but should not be
# tracked. Aggregate findings worth preserving go into eval-trajectory.md
# or other curated docs.
docs/STAGE-B-EVAL-RESULTS-*.md

# func-verify per-session reports/results — point-in-time measurements tied to a
# specific machine + corpus snapshot (embed absolute paths + src_commit). The
# reusable scaffolding (verify.py, ground-truth-*.json, PLAN.md) IS tracked.
eval/stablenet/func-verify/Report-*.md
eval/stablenet/func-verify/results-*.json

# Per-session code audit reports — one-shot snapshots, not specs.
docs/CODE-AUDIT-*.md

# stray root build artifact — always use `make build` (outputs to bin/, ignored)
/ckg

# make eval-ckv-mirror writes the regenerable graph here (corpus + fixtures are tracked)
eval/ckv-mirror/.index/

# make eval-stablenet-keyword output (fixtures are tracked, results are per-run)
eval/stablenet-keyword/results.json
